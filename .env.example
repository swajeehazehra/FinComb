# Copy this file to .env and change the password.
# .env is git-ignored: never commit real credentials.

# --- PostgreSQL (used by docker-compose and by the app) ---
POSTGRES_USER=fincomb
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fincomb
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Separate database for integration tests (created automatically by docker-compose).
POSTGRES_TEST_DB=fincomb_test

# --- Application ---
LOG_LEVEL=INFO
# true = one JSON object per log line (useful in Docker), false = human readable
LOG_JSON=false
# yfinance | tiingo | csv
DEFAULT_DATA_SOURCE=yfinance
# Free token for the Tiingo fallback source (optional):
# sign up at https://www.tiingo.com, then copy it from https://www.tiingo.com/account/api/token
TIINGO_API_KEY=
# Folder used by the csv source
CSV_DATA_DIR=tests/fixtures

# Optional: the code version stored with each backtest (default: `git rev-parse HEAD`).
# Set it where git is not available, e.g. in a Docker image.
# FINCOMB_CODE_VERSION=
